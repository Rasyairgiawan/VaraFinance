# GEMINI_API_KEY: Required for Gemini AI API calls (optional).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE_CONFIGURATION (Frontend-safe anon key only — NEVER put service_role key here!)
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# SUPABASE_EDGE_FUNCTION_SECRETS (Set via `supabase secrets set` — NEVER prefix with VITE_!)
# Comma-separated origins allowed to invoke the `username-auth` Edge Function in production.
# Example: ALLOWED_ORIGINS="https://your-production-domain.example"
ALLOWED_ORIGINS=""
